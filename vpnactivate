#!/usr/bin/env bash

# ==========================================
# PROTONVPN WIREGUARD
# Arch / Fedora / Debian based distros
#
# Imports the newest ProtonVPN WireGuard config from your Downloads
# folder as the NetworkManager connection "proton" and adds the
# vpnon / vpnoff aliases. Re-run it with a new config (e.g. another
# country) to replace the existing "proton" connection.
# ==========================================

# ------------------------------------------
# Make sure we are running Bash
# ------------------------------------------

if [ -z "$BASH_VERSION" ]; then
    echo "ERROR: This script must be run with Bash."
    exit 1
fi

set -e

# ------------------------------------------
# Detect distribution
# ------------------------------------------

if [ ! -f /etc/os-release ]; then
    echo "ERROR: Cannot determine Linux distribution."
    exit 1
fi

. /etc/os-release

case "$ID" in
    arch|endeavouros|manjaro|garuda|cachyos)
        DISTRO="arch"
        ;;

    fedora)
        DISTRO="fedora"
        ;;

    debian|ubuntu|linuxmint|pop)
        DISTRO="debian"
        ;;

    *)
        case "${ID_LIKE:-}" in
            *arch*)
                DISTRO="arch"
                ;;
            *fedora*|*rhel*)
                DISTRO="fedora"
                ;;
            *debian*|*ubuntu*)
                DISTRO="debian"
                ;;
            *)
                echo "ERROR: Unsupported distribution: $ID"
                echo "Supported: Arch-based, Fedora-based, Debian/Ubuntu-based"
                exit 1
                ;;
        esac
        ;;
esac

echo
echo "Detected distribution family: $DISTRO"
echo

# ------------------------------------------
# Find newest WireGuard config in Downloads
# (done first, so nothing is changed if there is none)
# ------------------------------------------

# The Downloads folder can have a translated name (e.g. ~/Scaricati)
DOWNLOADS="$HOME/Downloads"
USER_DIRS="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"

if command -v xdg-user-dir >/dev/null 2>&1; then
    XDG_DL=$(xdg-user-dir DOWNLOAD 2>/dev/null || true)
elif [ -f "$USER_DIRS" ]; then
    XDG_DL=$(. "$USER_DIRS" 2>/dev/null; echo "${XDG_DOWNLOAD_DIR:-}")
fi

if [ -n "${XDG_DL:-}" ] && [ "$XDG_DL" != "$HOME" ] && [ -d "$XDG_DL" ]; then
    DOWNLOADS="$XDG_DL"
fi

if [ ! -d "$DOWNLOADS" ]; then
    echo "ERROR: Downloads folder not found: $DOWNLOADS"
    exit 1
fi

is_wireguard_conf() {
    grep -q '^[[:space:]]*\[Interface\]' "$1" &&
    grep -q '^[[:space:]]*PrivateKey[[:space:]]*=' "$1" &&
    grep -q '^[[:space:]]*\[Peer\]' "$1"
}

LATEST_CONF=""

while IFS= read -r conf; do
    if is_wireguard_conf "$conf"; then
        LATEST_CONF="$conf"
        break
    fi
done < <(find "$DOWNLOADS" \
    -maxdepth 1 \
    -type f \
    -name '*.conf' \
    -printf '%T@ %p\n' 2>/dev/null |
    sort -nr |
    cut -d' ' -f2-)

if [ -z "$LATEST_CONF" ]; then
    echo "ERROR: No WireGuard .conf file found in $DOWNLOADS"
    echo "Download a WireGuard config from your ProtonVPN account and run this again."
    echo "Nothing was changed."
    exit 1
fi

echo "Found latest WireGuard config:"
echo "$LATEST_CONF"
echo

# ------------------------------------------
# Install required packages
# ------------------------------------------

case "$DISTRO" in
    arch)
        sudo pacman -S --needed networkmanager wireguard-tools
        ;;

    fedora)
        sudo dnf install -y NetworkManager wireguard-tools
        ;;

    debian)
        sudo apt update
        sudo apt install -y network-manager wireguard-tools
        ;;
esac

# ------------------------------------------
# Enable and start NetworkManager
# ------------------------------------------

sudo systemctl enable --now NetworkManager

# ------------------------------------------
# Create temporary valid filename
# (the file name becomes the interface name, which must be short)
# ------------------------------------------

TEMP_DIR=$(mktemp -d)
TEMP_CONF="$TEMP_DIR/proton.conf"

cp "$LATEST_CONF" "$TEMP_CONF"

# Make sure temporary file is removed if script exits
trap 'rm -rf "$TEMP_DIR"' EXIT

# ------------------------------------------
# Remove existing "proton" connection(s)
# so the new config replaces the old one
# ------------------------------------------

nmcli -t -f NAME,UUID connection show |
    awk -F: '$1 == "proton" {print $2}' |
    while IFS= read -r uuid; do
        echo "Removing old proton connection ($uuid)"
        sudo nmcli connection delete uuid "$uuid"
    done

# ------------------------------------------
# Remember existing connections
# ------------------------------------------

BEFORE=$(nmcli -t -f UUID connection show)

# ------------------------------------------
# Import WireGuard configuration
# ------------------------------------------

echo "Importing WireGuard configuration..."

if ! sudo nmcli connection import \
    type wireguard \
    file "$TEMP_CONF"; then
    echo "ERROR: NetworkManager could not import $LATEST_CONF"
    exit 1
fi

# ------------------------------------------
# Find newly imported connection
# ------------------------------------------

NEW_UUID=$(nmcli -t -f UUID connection show | while IFS= read -r uuid; do
    if ! printf '%s\n' "$BEFORE" | grep -Fxq "$uuid"; then
        printf '%s\n' "$uuid"
        break
    fi
done)

if [ -z "$NEW_UUID" ]; then
    echo "ERROR: Could not find the newly imported WireGuard connection."
    exit 1
fi

# ------------------------------------------
# Rename to "proton" and disable automatic connection
# ------------------------------------------

sudo nmcli connection modify \
    "$NEW_UUID" \
    connection.id "proton" \
    connection.autoconnect no

# ------------------------------------------
# Set up Bash aliases
# ------------------------------------------

BASHRC="$HOME/.bashrc"

touch "$BASHRC"

sed -i '/^[[:space:]]*# ProtonVPN WireGuard$/d;/^[[:space:]]*alias vpnon=/d;/^[[:space:]]*alias vpnoff=/d' "$BASHRC"

# Remove blank lines left at the end, so re-runs don't pile them up
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$BASHRC"

cat >> "$BASHRC" <<'EOF'

# ProtonVPN WireGuard
alias vpnon='sudo nmcli connection up proton'
alias vpnoff='sudo nmcli connection down proton'
EOF

# ------------------------------------------
# Finish
# ------------------------------------------

echo
echo "=========================================="
echo " ProtonVPN setup complete!"
echo "=========================================="
echo
echo "Distribution:"
echo "$PRETTY_NAME"
echo
echo "Config imported:"
echo "$LATEST_CONF"
echo
echo "NetworkManager connection:"
echo "proton"
echo
echo "Automatic connection:"
echo "disabled"
echo
echo "Commands (open a new terminal first, or run: source ~/.bashrc):"
echo
echo "  vpnon   -> Connect to ProtonVPN"
echo "  vpnoff  -> Disconnect from ProtonVPN"
echo
echo "=========================================="
